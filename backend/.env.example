# Copy this file to backend/.env and fill in your own values.
# backend/.env is git-ignored. Never commit real credentials.

# MongoDB Atlas connection string (Atlas > Database > Connect > Drivers).
# URL-encode special characters in the password (e.g. @ -> %40).
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority

# Optional: database name. Overrides the name in MONGODB_URI; if neither is set, MongoDB uses "test".
MONGODB_DB_NAME=harbor_homes_crm

# Express API
NODE_ENV=development
HOST=127.0.0.1
PORT=5000

# How long a sign-in lasts, in hours.
SESSION_TTL_HOURS=12
