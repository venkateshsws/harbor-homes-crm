# Copy this file to php-api/.env and fill in the real values there.
# Never commit php-api/.env. Use the same database as the existing Node backend.

APP_ENV=development
HOST=127.0.0.1
PORT=8080

MONGODB_URI=mongodb+srv://USER:PASSWORD@HOST/harbor_homes_crm?retryWrites=true&w=majority
MONGODB_DB_NAME=harbor_homes_crm

SESSION_TTL_HOURS=12
APP_TIMEZONE=Asia/Kolkata

# Optional CA bundle for the MongoDB driver. Needed when PHP cannot use the system trust store.
# MONGODB_TLS_CA_FILE=C:/path/to/cacert.pem

# Optional collection overrides. Leave unset to use the Mongoose collection names.
# MONGODB_COLLECTION_USERS=users
# MONGODB_COLLECTION_SESSIONS=sessions
# MONGODB_COLLECTION_COMPANIES=companies
# MONGODB_COLLECTION_LEADS=leads
# MONGODB_COLLECTION_ATTENDANCES=attendances
# MONGODB_COLLECTION_FOLLOWUPS=followups
# MONGODB_COLLECTION_LEADCALLS=leadcalls
# MONGODB_COLLECTION_SITEVISITS=sitevisits
# MONGODB_COLLECTION_DRIPCAMPAIGNS=dripcampaigns
# MONGODB_COLLECTION_DRIPENROLLMENTS=dripenrollments
# MONGODB_COLLECTION_DRIPMESSAGELOGS=dripmessagelogs
# MONGODB_COLLECTION_LEADNOTES=leadnotes
# MONGODB_COLLECTION_LEADASSIGNMENTS=leadassignments
